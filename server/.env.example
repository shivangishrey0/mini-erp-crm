# Supabase Transaction pooler, port 6543 (used at runtime by the app).
# Get this from Supabase dashboard -> Connect -> "Transaction pooler" tab.
# Keep the ?pgbouncer=true flag - Prisma needs it to avoid prepared
# statements, which PgBouncer's transaction mode doesn't support.
# Example: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# Supabase Session pooler, port 5432 (used by Prisma Migrate).
# Get this from Supabase dashboard -> Connect -> "Session pooler" tab -
# NOT the "Direct connection" tab, which is IPv6-only and unreachable from
# hosts like Render. Session pooler is IPv4 and behaves like a direct
# connection, which migrations need.
# Example: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=

# Secret used to sign/verify JWTs - use a long random string, never commit the real value
JWT_SECRET=

PORT=

# Deployed frontend origin, e.g. https://your-app.vercel.app - CORS only allows
# requests from this origin. Defaults to http://localhost:5173 if unset.
CLIENT_URL=
