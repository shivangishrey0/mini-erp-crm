generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  OPERATIONS
  SALES
}

enum CustomerType {
  RETAIL
  WHOLESALE
  DISTRIBUTOR
}

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
}

enum MovementType {
  IN
  OUT
}

enum OrderStatus {
  RESERVED
  FULFILLED
  CANCELLED
}

enum WorkOrderStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
}

enum TransferStatus {
  REQUESTED
  DISPATCHED
  RECEIVED
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())

  followUps  FollowUpNote[]
  movements  StockMovement[]
  orders     Order[]
  workOrders WorkOrder[]
  transfers  Transfer[]
}

model Customer {
  id           String         @id @default(uuid())
  name         String
  mobile       String
  email        String?
  businessName String
  gstNumber    String?
  type         CustomerType
  address      String
  status       CustomerStatus @default(LEAD)
  followUpDate DateTime?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  followUps FollowUpNote[]
  orders    Order[]
}

model FollowUpNote {
  id         String   @id @default(uuid())
  note       String
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String
  createdBy  User     @relation(fields: [userId], references: [id])
  userId     String
  createdAt  DateTime @default(now())
}

model Product {
  id            String   @id @default(uuid())
  name          String
  sku           String   @unique
  category      String
  unitPrice     Decimal  @db.Decimal(10, 2)
  minStockAlert Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  inventoryRecords InventoryRecord[]
  movements        StockMovement[]
  orderItems       OrderItem[]
  workOrders       WorkOrder[]
  transfers        Transfer[]
}

model Location {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())

  inventoryRecords InventoryRecord[]
  stockMovements   StockMovement[]
  orderItems       OrderItem[]
  workOrders       WorkOrder[]
  transfersOut     Transfer[]        @relation("TransferSource")
  transfersIn      Transfer[]        @relation("TransferDestination")
}

// The brief's "Inventory" entity: one row per Item x Location x Batch.
model InventoryRecord {
  id          String   @id @default(uuid())
  product     Product  @relation(fields: [productId], references: [id])
  productId   String
  location    Location @relation(fields: [locationId], references: [id])
  locationId  String
  batch       String
  physicalQty Int      @default(0)
  reservedQty Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([productId, locationId, batch])
}

model StockMovement {
  id         String       @id @default(uuid())
  product    Product      @relation(fields: [productId], references: [id])
  productId  String
  location   Location     @relation(fields: [locationId], references: [id])
  locationId String
  batch      String
  quantity   Int
  type       MovementType
  reason     String
  createdBy  User         @relation(fields: [userId], references: [id])
  userId     String
  createdAt  DateTime     @default(now())
}

model Order {
  id            String      @id @default(uuid())
  orderNumber   String      @unique
  customer      Customer    @relation(fields: [customerId], references: [id])
  customerId    String
  status        OrderStatus @default(RESERVED)
  totalQuantity Int
  createdBy     User        @relation(fields: [userId], references: [id])
  userId        String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items OrderItem[]
}

model OrderItem {
  id          String   @id @default(uuid())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  product     Product  @relation(fields: [productId], references: [id])
  productId   String
  location    Location @relation(fields: [locationId], references: [id])
  locationId  String
  batch       String
  productName String
  sku         String
  unitPrice   Decimal  @db.Decimal(10, 2)
  quantity    Int
}

model WorkOrder {
  id              String          @id @default(uuid())
  workOrderNumber String          @unique
  location        Location        @relation(fields: [locationId], references: [id])
  locationId      String
  product         Product         @relation(fields: [productId], references: [id])
  productId       String
  requiredQty     Int
  assignedUser    User            @relation(fields: [assignedUserId], references: [id])
  assignedUserId  String
  status          WorkOrderStatus @default(ASSIGNED)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Transfer {
  id                    String         @id @default(uuid())
  transferNumber        String         @unique
  sourceLocation        Location       @relation("TransferSource", fields: [sourceLocationId], references: [id])
  sourceLocationId      String
  destinationLocation   Location       @relation("TransferDestination", fields: [destinationLocationId], references: [id])
  destinationLocationId String
  product               Product        @relation(fields: [productId], references: [id])
  productId             String
  batch                 String
  quantity              Int
  status                TransferStatus @default(REQUESTED)
  requestedBy           User           @relation(fields: [requestedById], references: [id])
  requestedById         String
  dispatchedAt          DateTime?
  receivedAt            DateTime?
  createdAt             DateTime       @default(now())
}
