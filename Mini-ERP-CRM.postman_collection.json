      "name": "Auth",
      "description": "Login (Admin) is the primary login for a full top-to-bottom collection run, since ADMIN passes every roleGuard in the API. Use the 'Role Logins' folder at the end of this collection to switch identities and test role-guard 403s individually.",
      "item": [
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('token', pm.response.json().token);",
